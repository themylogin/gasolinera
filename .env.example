# Absolute path outside this repository, with 10 GB free. It holds the routing graph.
OSRM_PATH=/path/to/repo/.data/osrm/spain

# The routing service. Empty means the osrm service of this Compose file.
OSRM_URL=

# OSRM's travel time is multiplied by this before the bot uses it.
TIME_MULTIPLIER=0.933

# The token that @BotFather issues
TELEGRAM_BOT_TOKEN=

# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
